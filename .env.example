# AI Provider Configuration (for AI-powered discovery)
# Copy this file to .env and fill in your values

# ─── AI Provider Settings ───
# Base URL của LLM provider (OpenAI-compatible endpoint)
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# API Key của bạn
AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Model sử dụng (dùng model rẻ như gpt-4o-mini để tiết kiệm chi phí)
AI_MODEL=openai/gpt-4o-mini

# Timeout cho mỗi request (giây)
AI_TIMEOUT=60

# ─── Webhook Notification Settings ───
# URL webhook nhận notification khi provider status thay đổi sau verify
# (Slack/Discord/Teams webhook, hoặc server của bạn). Trống = tắt thông báo.
WEBHOOK_URL=

# Timeout cho mỗi webhook request (giây)
WEBHOOK_TIMEOUT=10

# Bật/tắt webhook notification (true/false)
WEBHOOK_ENABLED=true

# ─── Deep Verification (cho lệnh `check`) ───
# API key dùng khi verify provider có auth (lệnh `check --api-key`).
# Có thể bỏ qua và truyền trực tiếp: python run.py check -p upstage --api-key up_...
#PROVIDER_API_KEY=
